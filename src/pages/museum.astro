---
import RetroLayout from "../layouts/RetroLayout.astro";
import Window from "../components/Window.astro";
import { computers } from "../data/computer";

const total = computers.length;
---

<RetroLayout title="Museum" activePage="museum">
  <div class="flex items-center justify-center h-full p-6">
    <Window title="Hardware Museum Stack" class="w-full max-w-5xl">
      <div class="flex flex-col md:flex-row">
        <div
          class="flex flex-col border-r-2 border-primary"
          style="width: 280px; shrink: 0;"
        >
          <div
            class="border-b-2 border-primary p-3 flex items-center justify-center bg-surface-container-highest"
            style="height: 140px;"
          >
            <div
              class="border-b-2 border-primary flex items-center justify-center bg-white"
              style="height: 140px;"
            >
              <img
                id="museum-img"
                src="/images/eniac.png"
                alt="ENIAC"
                class="w-full h-full object-contain"
                style="filter: grayscale(100%); mix-blend-mode: multiply;"
              />
            </div>
          </div>

          <div
            class="flex items-center justify-between p-3 border-b-2 border-primary"
          >
            <button
              id="btn-prev"
              class="w-10 h-10 border-2 border-primary flex items-center justify-center cursor-pointer hover:bg-primary hover:text-on-primary font-mono font-bold"
            >
              <span class="material-symbols-outlined">arrow_back</span>
            </button>

            <span
              class="font-mono text-label-lg uppercase tracking-widest"
              id="museum-counter"
            >
              Card 1 of {total}
            </span>

            <button
              id="btn-next"
              class="w-10 h-10 border-2 border-primary flex items-center justify-center cursor-pointer hover:bg-primary hover:text-on-primary font-mono font-bold"
            >
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
          </div>

          <div class="flex items-center gap-2 p-3">
            <span class="material-symbols-outlined">search</span>
            <input
              id="museum-search"
              type="text"
              placeholder="Find hardware..."
              class="bg-transparent border-none outline-none font-mono text-label-sm w-full uppercase placeholder:opacity-50"
            />
          </div>
        </div>

        <div class="flex-1 flex flex-col p-5 gap-4">
          <div>
            <div
              class="font-mono text-label-sm opacity-70 mb-1"
              id="museum-type"
            >
              PERSONAL
            </div>
            <div
              class="font-mono text-headline-lg font-bold leading-tight"
              id="museum-name"
            >
              {computers[0].name} ({computers[0].year})
            </div>
          </div>

          <div>
            <div class="font-mono text-label-sm opacity-70 mb-1">
              DESCRIPTION
            </div>
            <div
              id="museum-description"
              class="font-body text-body-lg leading-relaxed border-2 border-primary p-2 bg-surface h-32 overflow-y-auto"
            >
              {computers[0].description}
            </div>
          </div>

          <div>
            <div class="font-mono text-label-sm opacity-70 mb-1">
              QUICK SPECS
            </div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1">
              {
                [
                  { label: "CPU", id: "mspec-cpu" },
                  { label: "RAM", id: "mspec-ram" },
                  { label: "SPEED", id: "mspec-speed" },
                  { label: "OS", id: "mspec-os" },
                ].map((row) => (
                  <div class="flex gap-2 border-b border-primary border-dotted py-1">
                    <span class="font-mono text-label-sm opacity-70 w-12 shrink-0">
                      {row.label}
                    </span>
                    <span class="font-mono text-label-sm" id={row.id}>
                      —
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <div
            class="mt-auto border-t-2 border-primary pt-3 flex justify-between items-center"
          >
            <span class="font-mono text-label-sm opacity-70"
              >ORIGINAL PRICE</span
            >
            <span class="font-mono text-headline-md font-bold" id="mspec-price"
              >—</span
            >
          </div>
        </div>
      </div>

      <div class="border-t-2 border-primary flex items-center gap-2 px-3 py-1">
        <div
          class="w-5 h-5 border border-primary flex items-center justify-center hover:bg-primary hover:text-on-primary cursor-pointer"
        >
          <span class="material-symbols-outlined" style="font-size:12px"
            >home</span
          >
        </div>
        <div
          class="w-5 h-5 border border-primary flex items-center justify-center hover:bg-primary hover:text-on-primary cursor-pointer"
        >
          <span class="material-symbols-outlined" style="font-size:12px"
            >menu</span
          >
        </div>
        <div class="flex-1"></div>
        <span class="font-mono text-label-sm opacity-70" id="museum-id"
          >ID: 0001</span
        >
      </div>
    </Window>
  </div>
</RetroLayout>

<script
  id="museum-data"
  type="application/json"
  is:inline
  set:html={JSON.stringify(computers)}
/>

<script is:inline>
  const data = JSON.parse(document.getElementById("museum-data").textContent);

  const iconMap = {
    Mainframe: "dns",
    Micro: "developer_board",
    Personal: "computer",
    "GUI Station": "desktop_windows",
    Revolution: "star",
    Workstation: "work",
  };

  let current = 0;

  function render(index) {
    const c = data[index];

    document.getElementById("museum-name").textContent =
      `${c.name} (${c.year})`;
    document.getElementById("museum-type").textContent = c.type.toUpperCase();
    document.getElementById("museum-description").textContent = c.description;
    document.getElementById("museum-counter").textContent =
      `Card ${index + 1} of ${data.length}`;
    document.getElementById("museum-id").textContent =
      `ID: ${String(index + 1).padStart(4, "0")}`;
    document.getElementById("museum-img").src = `/images/${c.id}.png`;
    document.getElementById("museum-img").alt = c.name;
    document.getElementById("mspec-cpu").textContent = c.cpu;
    document.getElementById("mspec-ram").textContent = c.ram;
    document.getElementById("mspec-speed").textContent = c.cpuSpeed;
    document.getElementById("mspec-os").textContent = c.os;
    document.getElementById("mspec-price").textContent = c.price;
  }

  render(0);

  document.getElementById("btn-next").addEventListener("click", () => {
    current = (current + 1) % data.length;
    render(current);
  });

  document.getElementById("btn-prev").addEventListener("click", () => {
    current = (current - 1 + data.length) % data.length;
    render(current);
  });

  document.getElementById("museum-search").addEventListener("input", (e) => {
    const query = e.target.value.toLowerCase();
    if (!query) return;
    const index = data.findIndex((c) => c.name.toLowerCase().includes(query));
    if (index !== -1) {
      current = index;
      render(current);
    }
  });
</script>
