---
import Window from "../Window.astro";
---

<Window
  title="System Specifications"
  id="window-specs"
  windowId="specs"
  class="w-72"
>
  <div class="p-4 flex flex-col gap-3">
    <div class="border-b border-primary border-dotted pb-2">
      <div class="font-mono text-label-sm opacity-70">PROCESSOR</div>
      <div class="font-mono text-label-lg">Motorola 68000 @ 8 MHz</div>
    </div>
    <div class="border-b border-primary border-dotted pb-2">
      <div class="font-mono text-label-sm opacity-70">MEMORY</div>
      <div class="font-mono text-label-lg">128 KB RAM</div>
    </div>
    <div class="border-b border-primary border-dotted pb-2">
      <div class="font-mono text-label-sm opacity-70">STORAGE</div>
      <div class="font-mono text-label-lg">400 KB Floppy Drive</div>
    </div>
    <div class="border-b border-primary border-dotted pb-2">
      <div class="font-mono text-label-sm opacity-70">DISPLAY</div>
      <div class="font-mono text-label-lg">512 × 342 px — 9" B&W</div>
    </div>
    <div class="border-b border-primary border-dotted pb-2">
      <div class="font-mono text-label-sm opacity-70">OPERATING SYSTEM</div>
      <div class="font-mono text-label-lg">System 1.0 — 1984</div>
    </div>
    <div>
      <div class="font-mono text-label-sm opacity-70">PRICE (1984)</div>
      <div class="font-mono text-label-lg">$2,495 USD</div>
    </div>
  </div>
</Window>
