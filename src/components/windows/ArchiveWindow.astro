---
import Window from "../Window.astro";
import { computers } from "../../data/computer";
---

<Window
  title="Historical Archive"
  footer={`${computers.length} items found - Storage: A:\\HISTORIC\\`}
  class="w-full flex-1 min-h-0"
  id="window-archive"
  windowId="archive"
>
  <div class="flex flex-col h-full">
    <div
      class="border-b-2 border-primary px-3 py-1 flex justify-between items-center bg-surface shrink-0"
    >
      <span class="font-mono text-label-sm">{computers.length} Items Found</span
      >
      <span class="font-mono text-label-sm">Sorted by Chronology</span>
      <span class="font-mono text-label-sm">Storage: A:\HISTORIC\</span>
    </div>

    <div class="flex-1 min-h-0 overflow-y-auto">
      <table class="w-full border-collapse">
        <thead class="sticky top-0 bg-surface z-10">
          <tr class="border-b border-primary">
            <th
              class="text-left font-mono text-label-sm px-3 py-2 border-r border-primary w-20"
              >Year</th
            >
            <th
              class="text-left font-mono text-label-sm px-3 py-2 border-r border-primary"
              >Machine Name</th
            >
            <th
              class="text-left font-mono text-label-sm px-3 py-2 border-r border-primary w-32"
              >Manufacturer</th
            >
            <th class="text-left font-mono text-label-sm px-3 py-2 w-28"
              >Type</th
            >
          </tr>
        </thead>
        <tbody id="computer-table-body">
          {
            computers.map((computer) => (
              <tr
                class="border-b border-primary border-dotted cursor-pointer hover:bg-primary hover:text-on-primary transition-none group computer-row"
                data-id={computer.id}
              >
                <td class="font-mono text-label-lg px-3 py-2 border-r border-primary border-dotted">
                  {computer.year}
                </td>
                <td class="font-mono text-label-lg px-3 py-2 border-r border-primary border-dotted font-bold">
                  <span class="material-symbols-outlined text-xs mr-1">
                    commit
                  </span>
                  {computer.name}
                </td>
                <td class="font-mono text-label-sm px-3 py-2 border-r border-primary border-dotted opacity-70 group-hover:opacity-100">
                  {computer.manufacturer}
                </td>
                <td class="font-mono text-label-sm px-3 py-2 italic">
                  {computer.type}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</Window>

<!-- Detail -->
<Window
  title="Selected Item"
  id="window-archive-detail"
  class="w-full shrink-0"
>
  <div id="detail-empty" class="p-4 flex items-center justify-center h-24">
    <span class="font-mono text-label-sm opacity-50"
      >— Select a machine from the list above —</span
    >
  </div>
  <div id="detail-content" class="hidden flex-col md:flex-row">
    <div class="flex-1 p-4 border-r-2 border-primary">
      <div class="font-mono text-label-sm opacity-70 mb-1" id="detail-type">
      </div>
      <div class="font-mono text-headline-md font-bold mb-3" id="detail-name">
      </div>
      <p class="font-body text-body-lg leading-relaxed" id="detail-description">
      </p>
      <div class="mt-3 border-t border-primary border-dotted pt-2">
        <span class="font-mono text-label-sm opacity-70">SIGNIFICANCE: </span>
        <span class="font-mono text-label-sm italic" id="detail-significance"
        ></span>
      </div>
    </div>
    <div class="w-72 shrink-0 p-4">
      <div class="font-mono text-label-sm opacity-70 mb-2">TECHNICAL SPECS</div>
      <table class="w-full">
        <tbody>
          {
            [
              { label: "CPU", id: "spec-cpu" },
              { label: "SPEED", id: "spec-speed" },
              { label: "RAM", id: "spec-ram" },
              { label: "OS", id: "spec-os" },
              { label: "PRICE", id: "spec-price" },
            ].map((row) => (
              <tr class="border-b border-primary border-dotted">
                <td class="font-mono text-label-sm opacity-70 py-1 pr-3 w-16">
                  {row.label}
                </td>
                <td class="font-mono text-label-sm py-1" id={row.id}>
                  —
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</Window>
