---
import "../styles/global.css";

interface Props {
  title: string;
  activePage: "desktop" | "archive" | "museum" | "terminal";
}

const { title, activePage } = Astro.props as Props;

const navItems = [
  { id: "desktop", label: "Desktop", href: "/" },
  { id: "archive", label: "Archive", href: "/archive" },
  { id: "museum", label: "Museum", href: "/museum" },
  { id: "terminal", label: "Terminal", href: "/terminal" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - RetroFinder</title>
  </head>
  <body class="bg-dither font-body text-primary h-screen overflow-hidden">
    <!-- TOP NAV BAR -->
    <header
      class="fixed top-0 w-full h-titlebar bg-surface border-b-2 border-primary flex items-center px-4 justify-between z-50"
    >
      <nav class="flex items-center gap-4">
        <span class="font-mono text-headline-md font-bold">RetroFinder</span>
        <div class="flex">
          {
            navItems.map((item) => (
              <span
                data-nav={item.id}
                class={`font-mono text-label-lg px-2 cursor-pointer no-underline ${activePage === item.id ? "bg-primary text-on-primary" : "text-primary hover:bg-primary hover:text-on-primary"}`}
              >
                {item.label}
              </span>
            ))
          }
        </div>
      </nav>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined cursor-pointer">help</span>
        <span class="material-symbols-outlined cursor-pointer">settings</span>
      </div>
    </header>

    <!-- SIDE NAV BAR -->
    <!-- <aside
      class="fixed left-0 top-titlebar h-full w-sidebar bg-surface border-r-2 border-primary flex flex-col py-4 z-40"
    >
      <div class="flex flex-col items-center gap-1 mb-6 text-center px-2">
        <span class="material-symbols-outlined" style="font-size: 32px;"
          >computer</span
        >
        <span class="font-mono text-label-sm">Finder 1.0</span>
        <span class="font-mono text-label-sm opacity-70">64K RAM</span>
      </div>
      <nav class="flex flex-col gap-2">
        {
          [
            { icon: "flaky", label: "Disks" },
            { icon: "terminal", label: "System" },
            { icon: "lan", label: "Network" },
            { icon: "delete", label: "Trash" },
          ].map((item) => (
            <div class="text-primary p-2 flex flex-col items-center gap-1 cursor-pointer hover:bg-primary-container hover:text-on-primary">
              <span class="material-symbols-outlined">{item.icon}</span>
              <span class="font-mono text-label-sm">{item.label}</span>
            </div>
          ))
        }
      </nav>
    </aside> -->

    <!-- MAIN CONTENT -->
    <main class="fixed inset-0 pt-titlebar pb-footer overflow-hidden">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer
      class="fixed bottom-0 w-full h-footer bg-surface border-t-2 border-primary flex justify-between items-center px-6 z-50"
    >
      <span class="font-mono text-label-lg">© 1984 RetroComputing Corp.</span>
      <div class="flex gap-4">
        {
          ["Specs", "Manual", "Credits"].map((link) => (
            <a
              href="#"
              class="font-body text-body-md no-underline text-primary hover:bg-primary hover:text-on-primary px-1"
            >
              {link}
            </a>
          ))
        }
      </div>
    </footer>

    <!-- CURSOR -->
    <svg
      id="retro-cursor"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 16 24"
      style="width:16px;height:24px;"
    >
      <!-- Normal cursor -->
      <g id="cursor-normal">
        <polygon
          points="0,0 0,14 3,11 6,17 8,16 5,10 9,10"
          fill="black"
          stroke="none"></polygon>
      </g>
      <!-- Wait cursor -->
      <g id="cursor-wait" style="display:none;">
        <rect x="4" y="0" width="8" height="6" fill="black"></rect>
        <rect
          x="1"
          y="6"
          width="14"
          height="12"
          fill="white"
          stroke="black"
          stroke-width="1.5"></rect>
        <rect x="4" y="8" width="8" height="6" fill="white"></rect>
        <line x1="8" y1="11" x2="8" y2="9" stroke="black" stroke-width="1"
        ></line>
        <line x1="8" y1="11" x2="10" y2="11" stroke="black" stroke-width="1"
        ></line>
        <rect x="7" y="10" width="2" height="2" fill="black"></rect>
        <rect x="4" y="18" width="8" height="6" fill="black"></rect>
      </g>
    </svg>

    <script is:inline>
      const cursor = document.getElementById("retro-cursor");
      const cursorNormal = cursor.querySelector("#cursor-normal");
      const cursorWait = cursor.querySelector("#cursor-wait");

      document.addEventListener("mousemove", (e) => {
        cursor.style.left = e.clientX + "px";
        cursor.style.top = e.clientY + "px";
      });

      document.addEventListener("mousedown", () => {
        cursor.style.transform = "translate(-1px, -1px) scale(0.85)";
      });
      document.addEventListener("mouseup", () => {
        cursor.style.transform = "translate(-1px, -1px) scale(1)";
      });

      const observer = new MutationObserver(() => {
        const isWaiting = document.body.classList.contains("cursor-wait");
        cursorNormal.style.display = isWaiting ? "none" : "block";
        cursorWait.style.display = isWaiting ? "block" : "none";
      });
      observer.observe(document.body, { attributeFilter: ["class"] });
    </script>
  </body>

  <!-- BOOT SCREEN -->
  <div
    id="boot-screen"
    class="fixed inset-0 bg-primary z-99999 flex flex-col items-center justify-center gap-6"
  >
    <!-- MAC ICON -->
    <div class="flex flex-col items-center gap-4">
      <img
        src="/icons/macintosh.svg"
        alt="Macintosh"
        style="width: 64px; height: 64px; filter: invert(1);"
      />
      <span class="font-mono text-on-primary text-label-lg tracking-widest"
        >RetroFinder 1.0</span
      >
    </div>

    <!-- LOADING BAR -->
    <div class="border border-on-primary" style="width: 200px; height: 12px;">
      <div id="boot-progress" class="bg-on-primary h-full" style="width: 0%;">
      </div>
    </div>

    <span
      class="font-mono text-on-primary text-label-sm opacity-50"
      id="boot-status">Starting up...</span
    >
  </div>

  <script is:inline>
    const bootScreen = document.getElementById("boot-screen");
    const bootProgress = document.getElementById("boot-progress");
    const bootStatus = document.getElementById("boot-status");

    if (sessionStorage.getItem("booted")) {
      bootScreen.style.display = "none";
    } else {
      const steps = [
        { pct: 15, msg: "Loading system...", delay: 400 },
        { pct: 30, msg: "Checking memory...", delay: 600 },
        { pct: 50, msg: "Loading RetroFinder...", delay: 500 },
        { pct: 70, msg: "Mounting volumes...", delay: 700 },
        { pct: 85, msg: "Starting desktop...", delay: 400 },
        { pct: 100, msg: "Welcome.", delay: 600 },
      ];

      let i = 0;

      function nextStep() {
        if (i >= steps.length) {
          // Fade out
          setTimeout(() => {
            bootScreen.style.transition = "opacity 0.6s ease";
            bootScreen.style.opacity = "0";
            setTimeout(() => {
              bootScreen.style.display = "none";
              sessionStorage.setItem("booted", "1");
            }, 600);
          }, 500);
          return;
        }

        const step = steps[i];
        bootProgress.style.transition = `width ${step.delay * 0.8}ms ease`;
        bootProgress.style.width = step.pct + "%";
        bootStatus.textContent = step.msg;
        i++;
        setTimeout(nextStep, step.delay);
      }

      setTimeout(nextStep, 300);
    }
  </script>
</html>
